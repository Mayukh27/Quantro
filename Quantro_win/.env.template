# ═══════════════════════════════════════════════════════════════════════════
# Quantro — Environment Configuration Template
# ═══════════════════════════════════════════════════════════════════════════
# 1. Copy this file:   copy .env.template .env
# 2. Fill in values below (especially DB_* and JWT_SECRET).
# 3. Run:             .\run.bat
# ═══════════════════════════════════════════════════════════════════════════

# ── DATABASE ────────────────────────────────────────────────────────────────
DB_URL=jdbc:postgresql://127.0.0.1:5432/examportal
DB_USERNAME=postgres
DB_PASSWORD=your_db_password_here

# ── SECURITY ────────────────────────────────────────────────────────────────
# Generate a strong secret — at least 64 random characters.
# Example (PowerShell): -join ((65..90)+(97..122)+(48..57) | Get-Random -Count 64 | % {[char]$_})
JWT_SECRET=replace_with_a_long_random_secret_at_least_64_chars

# ── MAIL (optional — only needed if FEATURE_EMAIL=true) ────────────────────
MAIL_USERNAME=noreply@example.com
MAIL_PASSWORD=mail_password

# ── PATHS ────────────────────────────────────────────────────────────────────
# Full path to nginx.exe on this machine.
NGINX_BIN=C:\nginx-1.30.0\nginx.exe

# Nginx listen port (use a high port to avoid admin privileges).
NGINX_PORT=8081

# Full path to java.exe (leave as "java" if Java 17+ is in PATH).
JAVA_BIN=java

# ── JVM TUNING ───────────────────────────────────────────────────────────────
# Heap: 512 MB min, 1 GB max. Increase Xmx on machines with more RAM.
JAVA_OPTS=-Xms512m -Xmx1024m

# ── SCALING (optional) ───────────────────────────────────────────────────────
# Run multiple backend instances for local load balancing.
# INSTANCES=1 means one instance on BASE_PORT.
# INSTANCES=2 means two instances on BASE_PORT and BASE_PORT+1.
# If INSTANCES > 1, uncomment the second upstream server line in nginx.windows.conf.
# INSTANCES=1
# BASE_PORT=18080

# ── FEATURE FLAGS ─────────────────────────────────────────────────────────────
# Toggle system features without rebuilding. true = enabled, false = disabled.
FEATURE_ADMIN=true
FEATURE_TEACHER=true
FEATURE_ANALYTICS=true
FEATURE_BLUEPRINT=true
FEATURE_PROCTOR=true
FEATURE_PDF=true
FEATURE_AI=false
FEATURE_EMAIL=false

# ── PROCTORING THRESHOLDS ─────────────────────────────────────────────────────
# Hard violations (tab switch, DevTools, keyboard shortcuts, etc.)
# before auto-submit. Default: 1 (submit on first hard violation).
PROCTOR_MAX_VIOLATIONS=1

# Fullscreen exits before auto-submit. Default: 1.
PROCTOR_MAX_FULLSCREEN_EXITS=1

# Seconds the student has to return to fullscreen before the exit counts.
PROCTOR_GRACE_SECONDS=10

# ── EXAM TIMER GRACE ─────────────────────────────────────────────────────────
# Extra seconds allowed beyond timer expiry for the final autosave to complete.
EXAM_GRACE_SECONDS=30

# ── PREFETCH (warm image cache on publish) ───────────────────────────────────
# When an exam is published, the backend will prefetch all question images
# through nginx to warm the disk cache. Disable if you do not run nginx.
PREFETCH_ENABLED=true

# Base URL for nginx (should match NGINX_PORT above).
PREFETCH_BASE_URL=http://localhost:8081
